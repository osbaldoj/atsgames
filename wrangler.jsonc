{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atsgames",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "atsgames.com", "custom_domain": true },
    { "pattern": "www.atsgames.com", "custom_domain": true },
  ],
  "observability": { "enabled": false },
}
